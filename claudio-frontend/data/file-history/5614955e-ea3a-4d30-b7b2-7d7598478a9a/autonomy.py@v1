#!/usr/bin/env python3
"""autonomy.py — run one Claudio self-check sweep and write a journal entry.

Usage:
    python3 scripts/autonomy.py            # sweep, print report, append to journal
    python3 scripts/autonomy.py --json     # machine-readable output
    python3 scripts/autonomy.py --check    # exit 1 if verdict != ok (for cron)

Writes JSON-lines to ./autonomy/journal.jsonl so findings accumulate and can be
trended over time. Exit code 1 on non-ok verdict when --check is passed.
"""
from __future__ import annotations

import json
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from claudio_api import call  # noqa: E402

JOURNAL = Path("autonomy/journal.jsonl")


def _g(d, *keys, default=None):
    cur = d
    for k in keys:
        if not isinstance(cur, dict) or k not in cur:
            return default
        cur = cur[k]
    return cur


def sweep() -> dict:
    """Collect every signal a self-check needs. Read-only."""
    out = {"ts": datetime.now(timezone.utc).isoformat(), "findings": []}

    ver, ok = call("GET", "/version")
    out["version"] = ver if ok else {"error": ver}
    if not ok:
        out["findings"].append({"sev": "critical", "what": "backend unreachable",
                               "evidence": str(ver)[:200]})
        return out

    mon, ok = call("GET", "/monitoring/health")
    out["components"] = mon
    for c in mon.get("checks", []):
        if c.get("status") not in ("ok", "running"):
            out["findings"].append({"sev": "critical",
                                   "what": f"component {c['name']} = {c['status']}",
                                   "evidence": json.dumps(c)})

    auto, ok = call("GET", "/autonomous/status")
    out["autonomous"] = {
        "enabled": auto.get("enabled"),
        "report_only": auto.get("report_only"),
        "health_check_enabled": auto.get("health_check_enabled"),
        "interval_minutes": auto.get("interval_minutes"),
        "notification_enabled": auto.get("notification_enabled"),
    }
    if not auto.get("enabled"):
        out["findings"].append({
            "sev": "warning",
            "what": "autonomous.enabled=false - scheduled tasks will NOT fire",
            "evidence": "GET /autonomous/status -> enabled: false"})
    if auto.get("report_only"):
        out["findings"].append({
            "sev": "info",
            "what": "report_only=true - no mutations will occur",
            "evidence": "GET /autonomous/status -> report_only: true"})

    h, ok = call("GET", "/autonomous/health")
    out["host_health"] = h
    chk = _g(h, "check", "details_json")
    if isinstance(chk, str):
        try:
            chk = json.loads(chk)
        except Exception:
            chk = []
    for c in (chk or []):
        if c.get("status") in ("warning", "critical"):
            out["findings"].append({"sev": c["status"],
                                   "what": f"{c.get('name')}: {c.get('message')}",
                                   "evidence": json.dumps(c)[:300]})

    issues, ok = call("GET", "/autonomous/issues")
    items = issues.get("issues", []) if isinstance(issues, dict) else []
    out["open_issues"] = len(items)
    for it in items:
        if it.get("severity") in ("warning", "critical", "error"):
            out["findings"].append({"sev": it["severity"],
                                   "what": f"issue #{it.get('id')}: {it.get('title','')[:120]}",
                                   "evidence": (it.get("detail") or "")[:300]})

    sk, ok = call("GET", "/skills")
    skills = sk.get("skills", []) if isinstance(sk, dict) else []
    out["skills"] = {"count": len(skills), "directory": sk.get("directory"),
                    "enabled": sk.get("enabled")}
    if not skills:
        out["findings"].append({"sev": "warning",
                               "what": "no skills loaded",
                               "evidence": f"GET /skills -> count 0, dir={sk.get('directory')}"})

    m, ok = call("GET", "/monitoring/metrics")
    out["metrics"] = {
        "runs_total": m.get("runs_total"), "runs_failed": m.get("runs_failed"),
        "tokens_in": m.get("tokens_in"), "tokens_out": m.get("tokens_out"),
        "cost_usd_total": m.get("cost_usd_total"),
        "tool_errors_total": m.get("tool_errors_total"),
        "llm_errors_total": m.get("llm_errors_total"),
    }
    if (m.get("runs_failed") or 0) > 0:
        out["findings"].append({"sev": "info",
                               "what": f"{m['runs_failed']} failed runs recorded",
                               "evidence": "GET /monitoring/metrics"})

    return out


def verdict(findings) -> str:
    sevs = {f["sev"] for f in findings}
    if "critical" in sevs:
        return "critical"
    if "warning" in sevs:
        return "warning"
    return "ok"


def render(rep) -> str:
    v = verdict(rep["findings"])
    lines = [f"# Self-check {rep['ts']}  VERDICT: {v.upper()}", ""]
    a = rep.get("autonomous", {})
    lines.append(f"autonomous: enabled={a.get('enabled')} report_only={a.get('report_only')} "
                 f"health_check={a.get('health_check_enabled')} interval={a.get('interval_minutes')}m")
    s = rep.get("skills", {})
    lines.append(f"skills: {s.get('count')} loaded from {s.get('directory')} (enabled={s.get('enabled')})")
    met = rep.get("metrics", {})
    lines.append(f"runs: total={met.get('runs_total')} failed={met.get('runs_failed')} "
                 f"cost=${met.get('cost_usd_total')}")
    lines.append(f"open issues: {rep.get('open_issues', 0)}")
    lines.append("")
    if rep["findings"]:
        lines.append("## Findings")
        for f in rep["findings"]:
            lines.append(f"- [{f['sev'].upper()}] {f['what']}")
            lines.append(f"    evidence: {f['evidence'][:160]}")
    else:
        lines.append("## Findings\n- none")
    lines.append("")
    lines.append("## Not checked")
    lines.append("- restore drill (needs a real backup target)")
    lines.append("- security hardening baseline (needs lynis/rkhunter run)")
    lines.append("- LLM quality (needs eval set)")
    return "\n".join(lines)


def main():
    as_json = "--json" in sys.argv
    check = "--check" in sys.argv

    rep = sweep()
    v = verdict(rep["findings"])
    rep["verdict"] = v

    JOURNAL.parent.mkdir(parents=True, exist_ok=True)
    with JOURNAL.open("a") as f:
        f.write(json.dumps(rep, default=str) + "\n")

    if as_json:
        print(json.dumps(rep, indent=2, default=str))
    else:
        print(render(rep))

    if check and v != "ok":
        sys.exit(1)


if __name__ == "__main__":
    main()
