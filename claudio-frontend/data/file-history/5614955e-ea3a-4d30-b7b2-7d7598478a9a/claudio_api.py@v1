#!/usr/bin/env python3
"""claudio_api.py — thin, verified client for the Claudio backend HTTP API.

Base: http://127.0.0.1:8100/api/v1   Auth: Authorization: Bearer <token>

Read the token from the config file rather than hardcoding it:
    python3 claudio_api.py token

Every subcommand maps to one verified endpoint. Run `python3 claudio_api.py --help`.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

BASE_DEFAULT = "http://127.0.0.1:8100/api/v1"
CONFIG_PATH = "/run/media/briggen/DEV/code/ai/claudio/claudio-backend/config/config.yaml"


def load_creds():
    """Return (base_url, token) read from the live config file."""
    base = os.environ.get("CLAUDIO_BASE", BASE_DEFAULT)
    token = os.environ.get("CLAUDIO_TOKEN")
    if not token:
        try:
            import yaml
            cfg = yaml.safe_load(open(CONFIG_PATH)) or {}
            token = cfg.get("server", {}).get("auth_token")
            host = cfg.get("server", {}).get("host", "127.0.0.1")
            port = cfg.get("server", {}).get("port", 8100)
            if os.environ.get("CLAUDIO_BASE") is None:
                base = f"http://{host}:{port}/api/v1"
        except Exception:
            pass
    if not token:
        sys.exit("no auth token: set CLAUDIO_TOKEN or fix " + CONFIG_PATH)
    return base, token


def call(method, path, body=None, base=None, token=None, timeout=30):
    if base is None or token is None:
        b, t = load_creds()
        base = base or b
        token = token or t
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        base + path, data=data, method=method,
        headers={"Content-Type": "application/json",
                 "Authorization": f"Bearer {token}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read().decode()
    except urllib.error.HTTPError as e:
        raw = e.read().decode()
        try:
            return {"__http_error__": e.code, **json.loads(raw)}, False
        except Exception:
            return {"__http_error__": e.code, "raw": raw[:500]}, False
    except Exception as e:
        return {"__error__": str(e)}, False
    try:
        return json.loads(raw), True
    except Exception:
        return {"raw": raw}, True


def _out(result):
    print(json.dumps(result, indent=2, default=str))


# ---- subcommands ---------------------------------------------------------

def cmd_get(args):
    _out(call("GET", args.path)[0])


def cmd_post(args):
    body = json.loads(args.body) if args.body else {}
    _out(call("POST", args.path, body)[0])


def cmd_put(args):
    body = json.loads(args.body) if args.body else {}
    _out(call("PUT", args.path, body)[0])


def cmd_token(args):
    base, token = load_creds()
    print(f"base={base}\ntoken={token}")


def cmd_snapshot(args):
    """One-shot read of everything an operator needs to know right now."""
    snap = {}
    for name, path in [
        ("version", "/version"),
        ("agent_status", "/agent/status"),
        ("monitoring_health", "/monitoring/health"),
        ("autonomous_status", "/autonomous/status"),
        ("tasks", "/autonomous/tasks"),
        ("issues", "/autonomous/issues"),
        ("skills", "/skills"),
    ]:
        snap[name] = call("GET", path)[0]
    _out(snap)


def main():
    p = argparse.ArgumentParser(description="Claudio backend API client")
    sub = p.add_subparsers(dest="cmd", required=True)

    g = sub.add_parser("get", help="GET a path, e.g. /config")
    g.add_argument("path")
    g.set_defaults(fn=cmd_get)

    q = sub.add_parser("post", help="POST a path with JSON body")
    q.add_argument("path")
    q.add_argument("--body", default="{}")
    q.set_defaults(fn=cmd_post)

    u = sub.add_parser("put", help="PUT a path with JSON body (merge-patch for /config)")
    u.add_argument("path")
    u.add_argument("--body", default="{}")
    u.set_defaults(fn=cmd_put)

    t = sub.add_parser("token", help="print base URL + token from config")
    t.set_defaults(fn=cmd_token)

    s = sub.add_parser("snapshot", help="read all operator-facing state at once")
    s.set_defaults(fn=cmd_snapshot)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
