+"""Data model and totals for a sales report."""
+
+from dataclasses import dataclass, field
+
+
+@dataclass
+class Line:
+    sku: str
+    qty: int
+    unit_price: float
+    discount_pct: float = 0.0
+
+
+@dataclass
+class Report:
+    title: str
+    lines: list = field(default_factory=list)
+
+
+def line_net(line):
+    gross = line.qty * line.unit_price
+    return gross - gross * line.discount_pct / 100.0
+
+
+def summarize(report):
+    total = 0.0
+    for ln in report.lines:
+        total += line_net(ln)
+    count = len(report.lines)
+    average = total / count if count else 0.0
+    return {
+        "title": report.title,
+        "count": count,
+        "total": round(total, 2),
+        "average": round(average, 2),
+    }
diff --git a/app/report/render.py b/app/report/render.py
new file mode 100644
index 0000000..cf55f53
--- /dev/null
+++ b/app/report/render.py
@@ -0,0 +1,18 @@
+"""Markdown rendering for a sales report."""
+
+from app.report.model import line_net, summarize
+
+
+def render_report(report):
+    data = summarize(report)
+    out = [
+        "# " + data["title"],
+        "",
+        "- lines: %d" % data["count"],
+        "- total: %.2f" % data["total"],
+        "- average: %.2f" % data["average"],
+        "",
+    ]
+    for ln in report.lines:
+        out.append("| %s | %d | %.2f" % (ln.sku, ln.qty, line_net(ln)) + " |")
+    return "\n".join(out) + "\n"
