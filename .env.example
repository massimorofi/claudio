# Claudio docker deployment — host-side configuration.
#
# Copy to `.env` and fill in the secrets. `.env` is gitignored; this template is
# committed. Docker Compose reads `.env` automatically for variable substitution,
# and `claudio-ctl` sources it too so the CLI sees the same ports and tokens.
#
# Values prefixed CLAUDIO__ are passed straight into the backend config loader
# (section__key, exactly two levels) and override whatever is in config.yaml.

# --- published ports ---------------------------------------------------------
# Web UI port on the host. The agent publishes nothing by default (D2).
CLAUDIO_HTTP_PORT=8080

# --- agent server ------------------------------------------------------------
CLAUDIO__SERVER__HOST=0.0.0.0
CLAUDIO__SERVER__PORT=8100
CLAUDIO__SERVER__AUTH_TOKEN=dev-token-change-me
# QUOTING GOTCHA: single-quote any JSON value here. `claudio-ctl` sources this
# file with `. ./.env`, and bash performs quote removal on assignment RHS — an
# unquoted or double-quoted `["http://x"]` arrives as `[http://x]`, which is not
# valid JSON, so the backend's config loader rejects it and the agent runtime
# never starts. Single quotes survive both bash sourcing and compose's own .env
# parsing.
CLAUDIO__SERVER__CORS_ORIGINS='["http://localhost:8080"]'

# --- LLM ---------------------------------------------------------------------
# Must be reachable from inside the Docker bridge network. A LAN IP works only if
# that host is reachable from the container's NAT; re-test after any network change.
CLAUDIO__LLM__BASE_URL=http://192.168.1.172:8731/v1
CLAUDIO__LLM__API_KEY=local
CLAUDIO__LLM__MODEL=halogen-qwen3.8-flash-next

# --- search providers (optional, but strongly recommended) ---------------------
CLAUDIO__SEARCH__BRAVE_API_KEY=
CLAUDIO__SEARCH__SERPER_API_KEY=
CLAUDIO__SEARCH__TAVILY_API_KEY=

# --- host directory the agent may edit ----------------------------------------
# Bind-mounted to /workspace in the agent container. Use an absolute path if you
# prefer; a relative path is resolved against the compose file's directory.
CLAUDIO_WORKSPACE_DIR=./workspace

# --- misc --------------------------------------------------------------------
TZ=UTC
# Image tag. Set to the short git SHA for an immutable, rollback-able build.
CLAUDIO_TAG=latest

# --- build-time identity -------------------------------------------------------
# The agent runs as this uid/gid. Defaults match the host user so bind-mounted
# repos stay writable. Override if your host user differs.
CLAUDIO_UID=1000
CLAUDIO_GID=1000
