# Claudio docker deployment — host-side configuration.
#
# Copy to `.env` and fill in the secrets. `.env` is gitignored; this template is
# committed. Docker Compose reads `.env` automatically for variable substitution,
# and `claudio-ctl` sources it too so the CLI sees the same ports and tokens.
#
# Values prefixed CLAUDIO__ are passed straight into the backend config loader
# (section__key, exactly two levels) and override whatever is in config.yaml.

# --- published ports ---------------------------------------------------------
# Web UI port on the host. The agent publishes nothing by default (D2).
CLAUDIO_HTTP_PORT=8080

# --- agent server ------------------------------------------------------------
CLAUDIO__SERVER__HOST=0.0.0.0
CLAUDIO__SERVER__PORT=8100
CLAUDIO__SERVER__AUTH_TOKEN=dev-token-change-me
# QUOTING GOTCHA: single-quote any JSON value here. `claudio-ctl` sources this
# file with `. ./.env`, and bash performs quote removal on assignment RHS — an
# unquoted or double-quoted `["http://x"]` arrives as `[http://x]`, which is not
# valid JSON, so the backend's config loader rejects it and the agent runtime
# never starts. Single quotes survive both bash sourcing and compose's own .env
# parsing.
CLAUDIO__SERVER__CORS_ORIGINS='["http://localhost:8080"]'

# --- LLM ---------------------------------------------------------------------
# Must be reachable from inside the Docker bridge network. A LAN IP works only if
# that host is reachable from the container's NAT; re-test after any network change.
CLAUDIO__LLM__BASE_URL=http://192.168.1.172:8731/v1
CLAUDIO__LLM__API_KEY=local
CLAUDIO__LLM__MODEL=halogen-qwen3.8-flash-next

# --- search providers (optional, but strongly recommended) ---------------------
CLAUDIO__SEARCH__BRAVE_API_KEY=
CLAUDIO__SEARCH__SERPER_API_KEY=
CLAUDIO__SEARCH__TAVILY_API_KEY=

# --- host directory the agent may edit ----------------------------------------
# Bind-mounted to /workspace in the agent container. Use an absolute path if you
# prefer; a relative path is resolved against the compose file's directory.
CLAUDIO_WORKSPACE_DIR=./workspace

# Host command runner. Start the stack with ./claudio-ctl so the host-side
# runner is started before the backend. Set false to use the container shell.
CLAUDIO_HOST_EXECUTION_ENABLED=true
CLAUDIO_HOST_EXEC_DIR=./.runtime
# This root is also mounted at the same path inside the agent container.
CLAUDIO_HOST_PROJECTS_DIR=/home/briggen/Dev/code/ai

# --- misc --------------------------------------------------------------------
TZ=UTC
# Image tag. Set to the short git SHA for an immutable, rollback-able build.
CLAUDIO_TAG=latest

# --- build-time identity -------------------------------------------------------
# The agent runs as this uid/gid. Defaults match the host user so bind-mounted
# repos stay writable. Override if your host user differs.
CLAUDIO_UID=1000
CLAUDIO_GID=1000

# --- Gortex code discovery (issue #54, Option B) ------------------------------
# Opt-in. When true, claudio-ctl adds the compose profile "gortex" so the Gortex
# daemon container starts alongside the agent, and the agent's mcp.servers gortex
# entry (transport: streamable_http, url: http://gortex:7411/mcp) can connect.
# Also set the gortex entry `enabled: true` in the config, then restart the agent.
# Leave false to keep the default stack unchanged (no gortex container).
CLAUDIO_GORTEX_ENABLED=false
# Pin the Gortex release for a reproducible image build; empty installs latest.
GORTEX_VERSION=
# Shared bearer token between the gortex daemon and the agent's mcp.servers
# gortex entry (Authorization header). Gortex requires a token for its
# non-localhost /mcp bind. CHANGE THIS for real deployments; it must match the
# Authorization header in config.yaml.
GORTEX_HTTP_TOKEN=claudio-gortex-internal-token
# Extra repositories the gortex daemon should track and index, comma-separated.
# The daemon only sees what is bind-mounted into it, so every path listed here
# must also be mounted at the identical path (compose mounts
# CLAUDIO_HOST_PROJECTS_DIR for exactly this reason). Empty means the daemon
# indexes only /workspace, which is the scratch notes dir -- not any code.
# Example: /home/briggen/Dev/code/ai/clams,/home/briggen/Dev/code/ai/claudio
GORTEX_EXTRA_REPOS=

# --- pluggable backend engine (issue #57) ------------------------------------
# Selects which agent engine backs the backend. One engine per backend process
# (deployment-wide, not per session). Default is `adk` (no extra CLI needed).
# Set to `opencode` or `claude_code` and use scripts/install-engine.sh (or the
# compose.engine-*.yaml overrides) to build the matching image.
# CLAUDIO_ENGINE=adk
#
# OpenCode uses the same OpenAI-compatible endpoint as CLAUDIO__LLM__* above.
# Pin the OpenCode CLI baked into the image (never 'latest'):
# OPENCODE_VERSION=0.0.0-pin-me
#
# Claude Code speaks the Anthropic Messages API (/v1/messages). Point
# CLAUDIO__LLM__BASE_URL at an Anthropic-compatible endpoint and set the key:
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_VERSION=0.0.0-pin-me
# Only set true after verifying the endpoint serves /v1/messages (e.g. via a
# conversion gateway); otherwise startup is refused:
# CLAUDE_CODE_ALLOW_OPENAI_ENDPOINT=false
