# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
htmlcov/

# --- Node / frontend --------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime data (created by Claudio while it runs) ------------------
# SQLite database, JSONL transcripts, backend logs, pid file.
claudio-backend/data/
claudio-frontend/data/

# Agent workspace: deliverables the agent writes, per-session file
# backups under file-history/, and ADK session databases under .claudio/.
/data/

# Claudio's own runtime state must never be tracked, wherever it appears.
# Belt-and-braces: the relocated state lives under data/workspaces/, but a
# stray .claudio/ from an older layout should never slip into a commit.
.claudio/

# Generated database / log / pid files wherever they appear
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
*.pid

# --- Local config & secrets ------------------------------------------
# The live config holds the LLM API key, the server auth token and SMTP
# credentials, so it is never committed. Claudio falls back to built-in
# defaults when the file is absent, so a fresh clone still boots.
claudio-backend/config/config.yaml
.env
.env.*
!.env.example

# --- Editors / OS -----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Claude Code local settings ---------------------------------------
# Personal permission/approval state; shared .claude/ files stay tracked.
.claude/settings.local.json

# --- Migration scratch -----------------------------------------------
# The original pre-refactor tree. It carries its own .git directory, which
# would land in this repo as a broken gitlink, so it stays out. Delete it
# outright once the migration is finished.
_upstream/

